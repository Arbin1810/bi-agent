# ============================================
# PROJECT STORAGE (Generated Runtime Data)
# ============================================
# These directories hold user uploads, reports, and charts
# that should never be committed to version control
storage/uploads/*
storage/reports/*
storage/charts/*
!storage/uploads/.gitkeep
!storage/reports/.gitkeep
!storage/charts/.gitkeep

# Keep the .gitkeep files so the folder structure is preserved
# but ignore all actual contents

