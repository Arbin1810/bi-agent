OPENAI_API_KEY=python -c "from dotenv import load_dotenv; import os; load_dotenv(); print('API key loaded:', bool(os.getenv('OPENAI_API_KEY')))"
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

DATABASE_URL=postgresql://user:pass@localhost:5432/business
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=100
LOG_LEVEL=INFO