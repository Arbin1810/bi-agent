# OPENAI_API_KEY=python -c "from dotenv import load_dotenv; import os; load_dotenv(); print('API key loaded:', bool(os.getenv('OPENAI_API_KEY')))"
# OPENAI_MODEL=gpt-4o
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# DATABASE_URL=postgresql://user:pass@localhost:5432/business
# STORAGE_PATH=./storage
# MAX_UPLOAD_SIZE_MB=100
# LOG_LEVEL=INFO


# ---------------------------------------------------------------------------
# LLM Configuration — Ollama (local, no API key required)
# ---------------------------------------------------------------------------
# Ollama exposes an OpenAI-compatible endpoint at /v1.
# Start Ollama first:   ollama serve
# Pull the model:       ollama pull llama3.1   (or your preferred model)
#
# The api_key value is required by the OpenAI SDK constructor but is IGNORED
# by Ollama. Any non-empty string works.
OPENAI_API_KEY=ollama-local
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=qwen2.5:7b-instruct

# ---------------------------------------------------------------------------
# Database — leave DATABASE_URL empty for CSV-only mode
# ---------------------------------------------------------------------------
# When empty (or unset), the app runs in CSV mode using the in-memory
# DataFrameSQLExecutor. Set this only if you want PostgreSQL mode.
DATABASE_URL=

# Example PostgreSQL URL (uncomment + fill if using a real DB):
# DATABASE_URL=postgresql://bi_user:password@localhost:5432/bi_agent

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
UPLOAD_DIR=storage/uploads
REPORTS_DIR=storage/reports
CHARTS_DIR=storage/charts

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50